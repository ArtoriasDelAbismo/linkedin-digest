# Copy to .env for local runs. On Railway, set these as service variables instead.

# LinkedIn developer app (Auth tab)
LINKEDIN_CLIENT_ID=77dodp2uued1ka
LINKEDIN_CLIENT_SECRET=

# Where this app is reachable. Locally http://localhost:8000; on Railway your service domain.
# <PUBLIC_URL>/callback must be listed under "Authorized redirect URLs" in the LinkedIn app.
PUBLIC_URL=http://localhost:8000

# Password for the status page and LinkedIn login links. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_KEY=

# Claude
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (Console → Settings → Workspaces, ID starts wrkspc_)
ANTHROPIC_WORKSPACE_ID=
# Language the post is written in
POST_LANGUAGE=English
# Optional: a sentence about you so posts match your voice
AUTHOR_VOICE=

# Email notifications via Resend (resend.com). Leave blank to print messages to the log instead.
# With the default sender, NOTIFY_EMAIL must be the email you signed up to Resend with.
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM=Weekly Tech Digest <digest@yourdomain.com>   (needs a domain verified in Resend)

# Schedule: day (mon..sun), hour (0-23) and IANA timezone
DIGEST_DAY=mon
DIGEST_HOUR=9
DIGEST_TZ=UTC
# Story posts: an email to choose one of the most relevant stories, then a post with its image.
# Days are comma-separated. Hour and timezone default to the digest's.
SPOTLIGHT_DAY=mon,wed
# SPOTLIGHT_HOUR=9
# SPOTLIGHT_TZ=UTC

# Where the SQLite database lives. On Railway, point this at a mounted volume, e.g. /data
DATA_DIR=.
